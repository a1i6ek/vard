{
	"name": "console",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"@types/qrcode": "1.5.6",
		"axe-core": "4.14.0",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jsdom": "30.1.3",
		"openapi-typescript": "7.4.4",
		"postcss-html": "1.7.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"stylelint": "16.12.0",
		"stylelint-config-standard": "^36.0.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@ark-ui/svelte": "5.24.3",
		"@simplewebauthn/browser": "14.0.0",
		"@tanstack/svelte-query": "6.3.5",
		"qrcode": "1.5.4",
		"remixicon": "4.8.0",
		"shiki": "4.5.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"esbuild": "^0.28.2"
	}
}
